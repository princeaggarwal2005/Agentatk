# ==============================================================================
# AGENTATK Environment Configuration Template
# Copy this file to .env and configure your preferred LLM provider API keys.
# ==============================================================================

# --- Primary Providers (At least one is required) ---
GROQ_API_KEY=your_groq_api_key_here
CEREBRAS_API_KEY=your_cerebras_api_key_here
OPENAI_API_KEY=your_openai_api_key_here
GEMINI_API_KEY=your_gemini_api_key_here
OPENROUTER_API_KEY=your_openrouter_api_key_here

# --- Local / Self-Hosted Models (Ollama, vLLM, LM Studio) ---
# DEFAULT_BASE_URL=http://localhost:11434/v1
# DEFAULT_MODEL=llama3.2

# --- Optional Security & Judge Configuration ---
# AGENTATK_JUDGE_MODEL=llama-3.3-70b-versatile
# AGENTATK_PORT=8080
